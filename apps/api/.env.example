# Matches docker-compose.yml at the repo root — copy this file to .env and
# adjust if you're pointing at something other than the local containers.

DATABASE_URL="postgresql://ndyhub:ndyhub_dev_only@localhost:5432/ndyhub"
REDIS_URL="redis://localhost:6379"

PORT=3000
WEB_APP_URL="http://localhost:3001"
# Where relying parties reach this API — published in the OIDC discovery
# document (GET /.well-known/openid-configuration). Only matters once a
# real site outside this repo needs to resolve these URLs itself.
API_URL="http://localhost:3000"

JWT_ACCESS_SECRET="change-me-in-every-environment"
JWT_REFRESH_SECRET="change-me-in-every-environment"

# Shared secret with the CRYNDY presale site — HMAC-SHA256 signs the raw
# body of every POST /webhooks/cryndy/purchase call. Must match on both sides.
CRYNDY_WEBHOOK_SECRET="change-me-in-every-environment"

# Encrypts TOTP 2FA secrets at rest (AES-256-GCM — see
# common/totp-crypto.util.ts). Required, not optional like the Stripe/OIDC
# fallbacks below: unlike those, there's no safe "generate one on the fly"
# fallback here — a secret that changes on every restart would permanently
# lock out every user who'd enabled 2FA. Set a real value before this goes
# anywhere near production, same as the JWT secrets above.
TOTP_ENCRYPTION_KEY="change-me-in-every-environment"

# Optional. Leave both blank for local dev — MembershipService falls back to
# activating a subscription directly instead of creating a real Stripe
# Checkout Session. Fill these in once there's a real Stripe account.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional. Leave both blank for local dev — OidcKeysService generates an
# ephemeral RSA keypair at boot instead (every restart invalidates
# previously-issued id_tokens and rotates what GET /.well-known/jwks.json
# publishes, which is fine for local dev only). To set a real one:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt
# then paste the PEM below with real newlines replaced by literal `\n`.
OIDC_RSA_PRIVATE_KEY=""
OIDC_RSA_KEY_ID=""

# Optional. Leave blank for local dev — GET /auth/oauth/providers reports
# { google: false }, and the frontend hides the "Sign in with Google"
# button accordingly instead of offering something that 400s. From a
# Google Cloud Console OAuth client (Web application type): set the
# authorized redirect URI to {API_URL}/auth/oauth/google/callback exactly.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional, and all four are required together once set (same reasoning
# as above — SocialAuthService.isConfigured checks all four). Needs a
# paid Apple Developer account: a Services ID (APPLE_CLIENT_ID, distinct
# from any app bundle ID), a Sign in with Apple key (.p8 file — its id is
# APPLE_KEY_ID, paste its contents below with real newlines replaced by
# literal `\n`, same convention as OIDC_RSA_PRIVATE_KEY), and the team's
# APPLE_TEAM_ID. Redirect URI (registered on the Services ID) must be
# exactly {API_URL}/auth/oauth/apple/callback.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
