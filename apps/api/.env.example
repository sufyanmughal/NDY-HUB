# Matches docker-compose.yml at the repo root — copy this file to .env and
# adjust if you're pointing at something other than the local containers.

DATABASE_URL="postgresql://ndyhub:ndyhub_dev_only@localhost:5432/ndyhub"
REDIS_URL="redis://localhost:6379"

PORT=3000
WEB_APP_URL="http://localhost:3001"
# Where relying parties reach this API — published in the OIDC discovery
# document (GET /.well-known/openid-configuration). Only matters once a
# real site outside this repo needs to resolve these URLs itself.
API_URL="http://localhost:3000"

JWT_ACCESS_SECRET="change-me-in-every-environment"
JWT_REFRESH_SECRET="change-me-in-every-environment"

# Shared secret with the CRYNDY presale site — HMAC-SHA256 signs the raw
# body of every POST /webhooks/cryndy/purchase call. Must match on both sides.
CRYNDY_WEBHOOK_SECRET="change-me-in-every-environment"

# Optional. Leave both blank for local dev — MembershipService falls back to
# activating a subscription directly instead of creating a real Stripe
# Checkout Session. Fill these in once there's a real Stripe account.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
