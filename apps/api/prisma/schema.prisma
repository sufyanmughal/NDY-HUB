// NDY HUB — Core API database schema
// Milestone 1 (Identity core): User, NDY ID, Passport verification, login-request tokens.
// Everything else (membership, CRYNDY, webhooks, documents) gets added in later milestones
// on top of this — this file is the system of record, nothing else writes identity data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VerificationLevel {
  LEVEL_0 // registered, nothing confirmed yet
  LEVEL_1 // email confirmed
  LEVEL_2 // + phone confirmed
  LEVEL_3 // + identity document confirmed
}

enum LoginRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum LoginRequestMethod {
  QR
  DEEP_LINK
}

// Milestone 6 (admin): a single role rather than the full multi-role matrix
// the proposal eventually wants (Verified User + Member + CRYNDY Holder +
// Business Verified, worn simultaneously) — that needs a join table and
// isn't needed yet to gate "can this person see the admin dashboard."
// The client's requested role set (FOUNDER, SUPER_ADMIN, DEVELOPER,
// FINANCE, SUPPORT, CONTENT, PARTNERS, AUDITOR) plus USER as the default.
// What each role can actually *do* is defined in code, not the schema —
// see common/permissions.ts. CONTENT and PARTNERS are assignable today but
// currently grant no permissions: there's no content or partner management
// feature yet for them to gate, so wiring a permission for either would be
// hollow. FOUNDER implicitly has every permission (see permissions.ts);
// every other role's access is exactly what's listed there, nothing more.
enum Role {
  USER
  FOUNDER
  SUPER_ADMIN
  DEVELOPER
  FINANCE
  SUPPORT
  CONTENT
  PARTNERS
  AUDITOR
}

model User {
  id                String            @id @default(uuid())
  ndyId             String            @unique // e.g. NDY-4F82XK — generated once, never reused, never editable
  email             String            @unique
  passwordHash      String?           // null for users who only ever sign in via Google/Apple/NDYAPPS
  fullName          String?
  profilePhotoUrl   String?

  // Passport Card fields — the data behind the public-facing digital
  // business card at /passport/:ndyId. All optional (collected via the
  // post-signup "Complete Your Passport" step, skippable, editable later
  // from Settings) except fullName above, which is the only field that
  // gates dashboard access (see DashboardGate + AuthService.getMe's
  // passportComplete). Flat fields rather than a nested JSON blob to
  // match every other field on this model and keep them individually
  // validatable/indexable.
  bio               String?
  country           String?
  website           String?
  linkedinUrl       String?
  instagramUrl      String?
  xUrl              String?
  businessName      String?
  businessRole      String?
  // Per-field visibility for the public passport view — a genuinely new
  // pattern on this model (nothing else here has a visibility toggle).
  // Default true so these columns existing doesn't silently blank out
  // anything for users who never touch the new settings.
  bioIsPublic       Boolean @default(true)
  countryIsPublic   Boolean @default(true)
  websiteIsPublic   Boolean @default(true)
  socialsIsPublic   Boolean @default(true)
  businessIsPublic  Boolean @default(true)

  verificationLevel VerificationLevel @default(LEVEL_0)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  identityVerifiedAt DateTime?
  // Single-use, TTL'd — same shape as every other one-time token in this
  // schema (LoginRequest.token, OAuthAuthorizationCode.code). Cleared back
  // to null the moment it's redeemed, so a unique index on the hash is safe
  // (no two *pending* tokens ever collide; used-up ones don't occupy the
  // index at all).
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?

  // Same single-use/TTL shape again, for the forgot-password flow. Shorter
  // TTL than email verification (1h vs 24h) — a password reset link is a
  // more sensitive credential than an email-confirm link, worth a tighter
  // window.
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?

  // TOTP 2FA. Unlike every other secret on this model, this one can't be a
  // one-way hash — the server has to recompute the current code to check
  // against it, so it's encrypted (AES-256-GCM, see
  // common/totp-crypto.util.ts) rather than hashed. `totpEnabledAt` null
  // means either 2FA was never set up, or setup is pending confirmation —
  // issueTotpSecret writes the encrypted secret immediately but only
  // confirmTotpSetup sets totpEnabledAt, so a half-finished setup (secret
  // generated, never confirmed with a real code from the app) never starts
  // gating login.
  totpSecretEncrypted String?
  totpEnabledAt        DateTime?
  totpBackupCodes      TotpBackupCode[]

  // Same single-use-token shape as the others, but proving factor 1
  // (password) passed rather than proving identity outright — login()
  // issues this instead of a session when 2FA is enabled, and
  // TotpService.verifyChallenge trades it for a real session once factor 2
  // (TOTP code or backup code) checks out. Very short TTL (5 min) since
  // it's meant to be redeemed within the same login attempt, not carried
  // around.
  twoFactorChallengeTokenHash String?   @unique
  twoFactorChallengeExpiresAt DateTime?

  role              Role              @default(USER)
  suspended         Boolean           @default(false)
  suspendedAt       DateTime?
  // Set by GdprService.deleteAccount — a self-service deletion, distinct
  // from an admin suspension. The row itself survives (financial records
  // like CryndyPurchase/Membership have a userId FK that must keep
  // resolving for legal/tax retention — see the schema note above
  // AuditLogEntry for the same reasoning), but every PII field on it gets
  // wiped and `suspended` flips true so login is blocked the same way an
  // admin suspension already blocks it.
  deletedAt         DateTime?

  ndyappsConnected  Boolean           @default(false)
  ndyappsConnectedAt DateTime?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  loginRequests      LoginRequest[]
  sessions            Session[]
  cryndyPurchases     CryndyPurchase[]
  ndybitsLedgerEntries NdybitsLedgerEntry[]
  memberships          Membership[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthGrants             OAuthGrant[]
  oauthRefreshTokens      OAuthRefreshToken[]
  passkeys                Passkey[]
  webauthnChallenges      WebauthnChallenge[]
  authIdentities          AuthIdentity[]
  oauthLoginExchanges     OAuthLoginExchange[]
  externalAuthLinkStates  ExternalAuthState[]
  supportTickets          SupportTicket[]

  @@index([ndyId])
}

// Issued once, in a batch, when 2FA is confirmed enabled — shown to the
// user exactly once (same "plaintext exists only at creation" pattern as
// OAuthClient.clientSecretHash), for the "I lost my phone" recovery path
// TOTP alone can't cover. Each code is single-use (usedAt), same as every
// other one-time credential in this schema.
model TotpBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One row per external identity provider linked to an account — Google or
// Apple's "sub" claim, the stable subject identifier that outlives an
// email change on their side. SocialAuthService looks this up first on
// every callback; a miss falls back to matching by email (linking a new
// provider onto an existing password-based account instead of minting a
// duplicate one) before finally creating a brand new account. This is
// exactly the duplicate-account prevention a dormant AuthIdentity table
// used to imply without actually doing — this one is wired into a real,
// working flow.
model AuthIdentity {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  // Snapshot of what the provider reported at link time, for support/debug
  // visibility only — the account's own `email` column is what's actually
  // used everywhere else; this never overwrites it on later logins.
  email          String?
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum AuthProvider {
  GOOGLE
  APPLE
}

// One row per registered authenticator (a phone, a security key, a
// platform credential like Windows Hello/Touch ID). publicKey/counter are
// exactly what @simplewebauthn/server's verifyRegistrationResponse hands
// back — counter must be persisted and checked on every subsequent login
// to detect a cloned authenticator (a real device's counter only ever
// increases; a clone replaying an old assertion reports a stale one).
model Passkey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  deviceLabel  String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// The WebAuthn ceremony is two round trips (options, then a signed
// response) and the server has to remember the exact challenge it issued
// in between. Registration always has an authenticated user (userId set);
// login is intentionally usernameless/discoverable — the browser prompts
// with whatever passkeys it has for this site before the server knows who
// it is — so userId is null there and the credential response itself
// (its credentialId) is what resolves to an account. `id` doubles as the
// opaque handle the client hands back at the second step (a challengeId),
// same "random single-use value, no separate secret needed" reasoning as
// LoginRequest.token.
model WebauthnChallenge {
  id        String   @id @default(uuid())
  challenge String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      WebauthnChallengeType
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum WebauthnChallengeType {
  REGISTRATION
  AUTHENTICATION
}

// CSRF/replay protection for the Google/Apple redirect dance: /oauth/:provider/start
// mints one of these before sending the browser off to the provider, the
// provider echoes `id` back as `state`, and the callback checks it matches
// (and hasn't been used or expired) before trusting anything else in the
// request. `nonce` is separately embedded in the authorize request and
// re-checked against the *id_token's* own nonce claim — state proves the
// callback correlates to a request this server made; nonce proves the
// id_token wasn't lifted from a different, earlier authentication.
// Usually fully anonymous — there's no account to attach this to until the
// provider's response resolves one, same reasoning as WebauthnChallenge's
// login branch. The one exception is linkUserId: Settings' "Connect
// Google/Apple" starts this same flow already signed in, and needs the
// callback to attach the resulting identity to *that* account rather than
// running the normal login-or-create resolution — which matters
// specifically when the provider account's email doesn't match the
// signed-in account's, so email-matching alone can't be trusted to do it.
model ExternalAuthState {
  id         String       @id @default(uuid())
  provider   AuthProvider
  nonce      String
  linkUserId String?
  linkUser   User?        @relation(fields: [linkUserId], references: [id], onDelete: Cascade)
  // Where to send the browser after a successful login — validated the
  // same way LoginPage's own `next` query param is (must be an in-app
  // relative path), stored here rather than round-tripped through the
  // provider since not every provider guarantees passing arbitrary extra
  // query params back untouched.
  redirectPath String
  expiresAt DateTime
  createdAt DateTime     @default(now())
}

// The callback endpoints (hit by a real browser redirect from Google/Apple,
// not a fetch call this app's frontend controls) can't hand back tokens as
// a JSON response — there's nothing to receive one. So the callback
// resolves the user, then redirects the browser to the frontend with one
// of these as a one-time opaque code; the frontend immediately exchanges
// it for a real session via a normal POST. Keeps the actual bearer
// credentials out of the URL/browser history/Referer header — only this
// single-use, 60-second-lived code goes there instead.
model OAuthLoginExchange {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// The QR / deep-link login handshake described in the proposal: short-lived, single-use.
model LoginRequest {
  id            String              @id @default(uuid())
  token         String              @unique
  method        LoginRequestMethod
  status        LoginRequestStatus  @default(PENDING)

  requestingIp       String?
  requestingDevice   String?
  requestingBrowser  String?
  requestingLocation String?

  userId        String?             // set once approved
  user          User?               @relation(fields: [userId], references: [id])

  expiresAt     DateTime
  approvedAt    DateTime?
  deniedAt      DateTime?
  // Set the moment the desktop side redeems an APPROVED request for a real
  // session, via /exchange. Guards against exchanging the same approval twice.
  sessionIssuedAt DateTime?
  createdAt     DateTime            @default(now())

  @@index([token])
  @@index([status])
}

// Milestone 5 (CRYNDY + NDYBITS): a purchase moving through the presale
// pipeline, from payment intake through compliance review to on-chain
// distribution. The status itself is the source of truth for what a user is
// allowed to see as "available" — ALLOCATED/LOCKED CRYNDY is owned but not
// yet spendable, and only AVAILABLE/DISTRIBUTED_ON_CHAIN should ever be
// summed into a balance a user can act on.
enum CryndyPurchaseStatus {
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  UNDER_REVIEW
  VERIFIED
  ALLOCATED
  LOCKED
  AVAILABLE
  DISTRIBUTED_ON_CHAIN
  CANCELLED
  REFUNDED
}

model CryndyPurchase {
  id        String @id @default(uuid())
  // Human-facing receipt number, e.g. CRY-2026-07-000184. Distinct from `id`
  // (uuid) so support/finance can reference something readable; not relied
  // on for uniqueness enforcement anywhere else in the system.
  reference String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amountPaid Decimal @db.Decimal(18, 2)
  currency   String // ISO 4217, e.g. "USD"

  cryndyAmount Decimal @db.Decimal(28, 8)
  bonusAmount  Decimal @default(0) @db.Decimal(28, 8)
  packageName  String?

  paymentMethod String // e.g. "card", "bank_transfer", "crypto"
  status        CryndyPurchaseStatus @default(PAYMENT_PENDING)

  // The presale site's own transaction id. Unique so the same webhook
  // delivery, replayed any number of times, only ever produces one row.
  providerTransactionId String @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  verifiedAt  DateTime?
  allocatedAt DateTime?

  @@index([userId])
  @@index([status])
}

// Append-only NDYBITS movement log. Balance is derived by summing this
// table rather than kept as a cached counter on User — see NdybitsService
// for why (correctness over micro-optimizing a read that isn't hot yet).
model NdybitsLedgerEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount Int // positive = credit, negative = debit
  reason String // e.g. "daily_login", "referral_bonus", "purchase_reward"

  // Nullable — a manual/admin credit has no external event to key off of.
  // When set (e.g. "cryndy_purchase:<purchaseId>"), it's what makes
  // creditNdybits() idempotent: the same triggering event can never post
  // two ledger entries, even if whatever calls it retries.
  sourceEventId String? @unique

  createdAt DateTime @default(now())

  @@index([userId])
}

// Milestone 4: tier names and real pricing are a business decision the
// client still needs to confirm (see NDYAPPS-INTEGRATION.md-style open
// items) — these six match the brief's placeholder names exactly so
// renaming later is a find/replace, not a data-model change.
enum MembershipTier {
  RISE
  FLOW
  PULSE
  VAULT
  MODE
  LEGACY
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

// One row per subscription period, not one row per user — cancelling and
// resubscribing (or changing tiers) creates a new row rather than mutating
// history, so "View membership history" has something real to show.
model Membership {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier          MembershipTier
  billingCycle  BillingCycle
  status        MembershipStatus @default(ACTIVE)

  startedAt        DateTime  @default(now())
  currentPeriodEnd DateTime
  cancelledAt      DateTime?

  // Null in local/dev environments without a Stripe key — see
  // MembershipService.subscribe for the dev-mode direct-activation path
  // that fills these in only once real Stripe is configured.
  stripeSubscriptionId String? @unique
  stripeCustomerId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// One row per successfully-processed Stripe event id. Stripe retries
// webhook deliveries until it gets a 2xx, so the same event can legitimately
// arrive more than once — this table is what makes handleCheckoutCompleted
// et al. safe to run twice on the same event instead of double-cancelling/
// double-creating a membership. Checked by StripeWebhookController before
// dispatching, same idempotency shape as CryndyPurchase.providerTransactionId.
model ProcessedStripeEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
}

// Deliberately not a foreign-key relation to User — an audit trail needs to
// survive the record it describes (e.g. an admin account that's later
// demoted, or eventually a deleted user), so both sides are denormalized
// snapshots of who/what at the time the action happened, not live links.
model AuditLogEntry {
  id            String   @id @default(uuid())
  adminUserId   String
  adminNdyId    String
  action        String   // e.g. "user.suspend", "user.role.update"
  targetUserId  String?
  targetNdyId   String?
  previousValue Json?
  newValue      Json?
  reason        String?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
}

enum RoleChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Dual-approval for role changes — the client's explicit requirement for
// "critical actions." A role change no longer applies the moment one admin
// clicks a button: it creates a PENDING row here, and a *different* admin
// (see RoleChangeRequestService.approve — same person can't approve their
// own request) has to approve it before the role actually changes. Same
// denormalized-snapshot reasoning as AuditLogEntry for who's who.
model RoleChangeRequest {
  id             String @id @default(uuid())
  targetUserId   String
  targetNdyId    String
  requestedRole  Role
  previousRole   Role

  requestedByUserId String
  requestedByNdyId  String
  requestReason     String?

  status RoleChangeRequestStatus @default(PENDING)

  reviewedByUserId String?
  reviewedByNdyId  String?
  reviewReason     String?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([targetUserId])
}

// --- SSO / OAuth2 + OpenID Connect provider ---
// NDY HUB is the identity provider; every connected NDJOYIT site is a
// registered "client" (relying party) that redirects here to authenticate
// instead of keeping its own password table. This is the missing piece
// that makes "one login for the ecosystem" true past NDY HUB's own
// dashboard — see NDYAPPS-INTEGRATION.md for the mobile-app equivalent.

// Admin-managed (see AdminOAuthClientsController) — one row per connected
// website. clientSecretHash follows the same pattern as refresh tokens
// throughout this schema: only a hash is ever stored, the plaintext secret
// is shown to the admin exactly once, at creation.
model OAuthClient {
  id               String   @id @default(uuid())
  clientId         String   @unique
  clientSecretHash String
  name             String   // shown on the consent screen, e.g. "NDJOYIT Services"
  redirectUris     String[] // exact-match whitelist — no partial/prefix matching
  allowedScopes    String[] // subset of the supported scope list this client may ever request
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  authorizationCodes OAuthAuthorizationCode[]
  grants             OAuthGrant[]
  refreshTokens      OAuthRefreshToken[]

  @@index([clientId])
}

// Short-lived, single-use — same shape and same reasoning as LoginRequest:
// a code is only ever good for one exchange at the token endpoint.
model OAuthAuthorizationCode {
  id          String      @id @default(uuid())
  code        String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri String
  scope       String      // space-separated, the actual scopes approved for this grant
  // PKCE (RFC 7636) — optional per-request, verified at /oauth/token if
  // present. Only S256 is accepted; "plain" is deliberately unsupported
  // (OAuth 2.1 drops it too — a challenge that doesn't need hashing to
  // verify isn't proof of anything). Every OAuthClient here is confidential
  // (has a client_secret), so PKCE isn't covering for a missing client
  // secret the way it does for a public/mobile client — it's an extra
  // layer against authorization-code interception regardless of client type.
  codeChallenge       String?
  codeChallengeMethod String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([code])
  @@index([userId])
}

// What a user has approved a given client to see — checked before showing
// the consent screen again (a returning user with an unchanged scope skips
// straight back to their app), and what "Revoke a website connection" on
// the Security page deletes.
model OAuthGrant {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scope     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  revokedAt DateTime?

  @@unique([userId, clientId])
  @@index([userId])
}

// A refresh token issued to a *third-party client*, not NDY HUB's own
// dashboard — deliberately a separate table from Session so revoking one
// connected website never touches the user's own NDY HUB login, and vice
// versa.
model OAuthRefreshToken {
  id        String      @id @default(uuid())
  tokenHash String      @unique
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scope     String
  createdAt DateTime    @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([clientId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the refresh token, never the raw value — a leaked database
  // row shouldn't be a usable credential.
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

// A user's own request; a single admin reply resolves it. Deliberately not
// a full threaded-conversation ticketing system — one message in, one
// message back, marked resolved. Real back-and-forth can graduate this
// into something richer once there's actual support volume to justify it.
model SupportTicket {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  message    String
  status     SupportTicketStatus @default(OPEN)
  adminReply String?
  repliedAt  DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId])
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
}
