// NDY HUB — Core API database schema
// Milestone 1 (Identity core): User, NDY ID, Passport verification, login-request tokens.
// Everything else (membership, CRYNDY, webhooks, documents) gets added in later milestones
// on top of this — this file is the system of record, nothing else writes identity data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VerificationLevel {
  LEVEL_0 // registered, nothing confirmed yet
  LEVEL_1 // email confirmed
  LEVEL_2 // + phone confirmed
  LEVEL_3 // + identity document confirmed
}

enum LoginRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

enum LoginRequestMethod {
  QR
  DEEP_LINK
}

// Milestone 6 (admin): a single role rather than the full multi-role matrix
// the proposal eventually wants (Verified User + Member + CRYNDY Holder +
// Business Verified, worn simultaneously) — that needs a join table and
// isn't needed yet to gate "can this person see the admin dashboard."
// The client's requested role set (FOUNDER, SUPER_ADMIN, DEVELOPER,
// FINANCE, SUPPORT, CONTENT, PARTNERS, AUDITOR) plus USER as the default.
// What each role can actually *do* is defined in code, not the schema —
// see common/permissions.ts. CONTENT and PARTNERS are assignable today but
// currently grant no permissions: there's no content or partner management
// feature yet for them to gate, so wiring a permission for either would be
// hollow. FOUNDER implicitly has every permission (see permissions.ts);
// every other role's access is exactly what's listed there, nothing more.
enum Role {
  USER
  FOUNDER
  SUPER_ADMIN
  DEVELOPER
  FINANCE
  SUPPORT
  CONTENT
  PARTNERS
  AUDITOR
}

model User {
  id                String            @id @default(uuid())
  // The permanent, never-regenerated identity — six characters, generated
  // once at signup. This is the real lookup/join key everywhere internally
  // (never ndyId below), so a role change can never break a URL, OAuth
  // claim, or anything else built from a user's public ID. See
  // common/ndy-id.util.ts.
  ndyCoreId         String            @unique
  // Denormalized display string, e.g. "NDY-FND-4F82XK" — rebuilt from
  // ndyCoreId + the current role (via ndyIdTypeForRole) every time role
  // changes, so every *read* just returns a ready-to-display value instead
  // of recomputing the type on every request. Never used as a lookup key —
  // see ndyCoreId above for why.
  ndyId             String            @unique
  email             String            @unique
  passwordHash      String?           // null for users who only ever sign in via Google/Apple/NDYAPPS
  fullName          String?
  profilePhotoUrl   String?

  // Passport Card fields — the data behind the public-facing digital
  // business card at /passport/:ndyId. All optional (collected via the
  // post-signup "Complete Your Passport" step, skippable, editable later
  // from Settings) except fullName above, which is the only field that
  // gates dashboard access (see DashboardGate + AuthService.getMe's
  // passportComplete). Flat fields rather than a nested JSON blob to
  // match every other field on this model and keep them individually
  // validatable/indexable.
  bio               String?
  country           String?
  website           String?
  linkedinUrl       String?
  instagramUrl      String?
  xUrl              String?
  businessName      String?
  businessRole      String?
  // Contact phone shown on the Passport card's info rows — distinct from
  // phoneVerifiedAt below (that's a leftover timestamp column for a phone
  // *verification* feature that was never finished; no number was ever
  // actually stored anywhere until this field). Same optional/skippable/
  // editable-later treatment as every other Passport Card field.
  phone             String?
  // Per-field visibility for the public passport view — a genuinely new
  // pattern on this model (nothing else here has a visibility toggle).
  // Default true so these columns existing doesn't silently blank out
  // anything for users who never touch the new settings.
  bioIsPublic       Boolean @default(true)
  countryIsPublic   Boolean @default(true)
  websiteIsPublic   Boolean @default(true)
  socialsIsPublic   Boolean @default(true)
  businessIsPublic  Boolean @default(true)
  phoneIsPublic     Boolean @default(true)

  verificationLevel VerificationLevel @default(LEVEL_0)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  identityVerifiedAt DateTime?
  // Single-use, TTL'd — same shape as every other one-time token in this
  // schema (LoginRequest.token, OAuthAuthorizationCode.code). Cleared back
  // to null the moment it's redeemed, so a unique index on the hash is safe
  // (no two *pending* tokens ever collide; used-up ones don't occupy the
  // index at all).
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?

  // Same single-use/TTL shape again, for the forgot-password flow — now a
  // typed-in 6-digit code rather than a link token (see AuthService.
  // resetPassword), so lookup is scoped by email first, then this hash is
  // checked against that one account; @unique is no longer load-bearing
  // for the lookup itself (a 6-digit space is too small to rely on
  // uniqueness the way the 32-char email-verification token can), just
  // kept as a defense-in-depth constraint. Both TTLs are 4:59, per
  // explicit direction — one mental model app-wide for "how long do I
  // have."
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?

  // TOTP 2FA. Unlike every other secret on this model, this one can't be a
  // one-way hash — the server has to recompute the current code to check
  // against it, so it's encrypted (AES-256-GCM, see
  // common/totp-crypto.util.ts) rather than hashed. `totpEnabledAt` null
  // means either 2FA was never set up, or setup is pending confirmation —
  // issueTotpSecret writes the encrypted secret immediately but only
  // confirmTotpSetup sets totpEnabledAt, so a half-finished setup (secret
  // generated, never confirmed with a real code from the app) never starts
  // gating login.
  totpSecretEncrypted String?
  totpEnabledAt        DateTime?
  totpBackupCodes      TotpBackupCode[]

  // SMS 2FA via Sinch's Verification API — Sinch owns the OTP itself (we
  // never generate/store/hash a code for this flow, unlike email
  // verification/password reset above). smsPhoneE164 is the *verified*
  // number this factor is bound to — deliberately separate from the
  // free-text `phone` Passport Card contact field above, since a user's
  // public contact number and their private 2FA number aren't guaranteed
  // to be the same. phoneVerifiedAt (already on this model, previously
  // dead) is set the moment this number is first confirmed, and
  // verificationLevel moves to LEVEL_2 the same way emailVerifiedAt moves
  // it to LEVEL_1.
  smsPhoneE164 String?   @unique
  smsEnabledAt DateTime?

  // Same single-use-token shape as the others, but proving factor 1
  // (password) passed rather than proving identity outright — login()
  // issues this instead of a session when 2FA is enabled, and
  // TotpService.verifyChallenge trades it for a real session once factor 2
  // (TOTP code or backup code) checks out. Very short TTL (5 min) since
  // it's meant to be redeemed within the same login attempt, not carried
  // around.
  twoFactorChallengeTokenHash String?   @unique
  twoFactorChallengeExpiresAt DateTime?

  role              Role              @default(USER)
  suspended         Boolean           @default(false)
  suspendedAt       DateTime?
  // Set by GdprService.deleteAccount — a self-service deletion, distinct
  // from an admin suspension. The row itself survives (financial records
  // like CryndyPurchase/Membership have a userId FK that must keep
  // resolving for legal/tax retention — see the schema note above
  // AuditLogEntry for the same reasoning), but every PII field on it gets
  // wiped and `suspended` flips true so login is blocked the same way an
  // admin suspension already blocks it.
  deletedAt         DateTime?

  ndyappsConnected  Boolean           @default(false)
  ndyappsConnectedAt DateTime?

  // The workspace this user lands in by default (their own personal
  // workspace for every existing user today — see WorkspaceService.
  // getOrCreatePersonalWorkspace). Nullable only because it's backfilled
  // after the fact for pre-existing rows; every user has exactly one by
  // the time the backfill migration finishes. Not a relation to keep this
  // model's own onDelete semantics untouched — Workspace deletion logic
  // lives in WorkspaceService, not a cascading FK here.
  defaultWorkspaceId String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  loginRequests      LoginRequest[]
  sessions            Session[]
  cryndyPurchases     CryndyPurchase[]
  ndybitsLedgerEntries NdybitsLedgerEntry[]
  memberships          Membership[]
  oauthAuthorizationCodes OAuthAuthorizationCode[]
  oauthGrants             OAuthGrant[]
  oauthRefreshTokens      OAuthRefreshToken[]
  passkeys                Passkey[]
  webauthnChallenges      WebauthnChallenge[]
  securityEvents          SecurityEvent[]
  authIdentities          AuthIdentity[]
  oauthLoginExchanges     OAuthLoginExchange[]
  externalAuthLinkStates  ExternalAuthState[]
  supportTickets          SupportTicket[]

  // --- NDYSPACE ("Your Digital Space") ---
  // Every NDYSPACE row hangs off this same User — there is no separate
  // NDYSPACE account/identity concept, same relational pattern as
  // NdybitsLedgerEntry/CryndyPurchase/Membership/SecurityEvent above.
  sentEmails              Email[]              @relation("EmailSender")
  emailRecipients         EmailRecipient[]
  calendarEvents          CalendarEvent[]
  driveFolders            DriveFolder[]
  driveFiles              DriveFile[]
  contacts                Contact[]
  tasks                   Task[]
  notes                   Note[]
  bookmarks               Bookmark[]
  ndyspaceNotifications   NdyspaceNotification[]

  workspaceMemberships    WorkspaceMembership[]
  notifications           Notification[]
  economyEventLogs        NdyEconomyEventLog[]
  bridgeRequests          BridgeRequest[]
  passportClaims          PassportClaim[]
  identityVerificationRequests IdentityVerificationRequest[]
  ecosystemEvents         EcosystemEvent[]

  @@index([ndyId])
}

// Issued once, in a batch, when 2FA is confirmed enabled — shown to the
// user exactly once (same "plaintext exists only at creation" pattern as
// OAuthClient.clientSecretHash), for the "I lost my phone" recovery path
// TOTP alone can't cover. Each code is single-use (usedAt), same as every
// other one-time credential in this schema.
model TotpBackupCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One row per external identity provider linked to an account — Google or
// Apple's "sub" claim, the stable subject identifier that outlives an
// email change on their side. SocialAuthService looks this up first on
// every callback; a miss falls back to matching by email (linking a new
// provider onto an existing password-based account instead of minting a
// duplicate one) before finally creating a brand new account. This is
// exactly the duplicate-account prevention a dormant AuthIdentity table
// used to imply without actually doing — this one is wired into a real,
// working flow.
model AuthIdentity {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  // Snapshot of what the provider reported at link time, for support/debug
  // visibility only — the account's own `email` column is what's actually
  // used everywhere else; this never overwrites it on later logins.
  email          String?
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

enum AuthProvider {
  GOOGLE
  APPLE
}

// One row per registered authenticator (a phone, a security key, a
// platform credential like Windows Hello/Touch ID). publicKey/counter are
// exactly what @simplewebauthn/server's verifyRegistrationResponse hands
// back — counter must be persisted and checked on every subsequent login
// to detect a cloned authenticator (a real device's counter only ever
// increases; a clone replaying an old assertion reports a stale one).
model Passkey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  deviceLabel  String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// The WebAuthn ceremony is two round trips (options, then a signed
// response) and the server has to remember the exact challenge it issued
// in between. Registration always has an authenticated user (userId set);
// login is intentionally usernameless/discoverable — the browser prompts
// with whatever passkeys it has for this site before the server knows who
// it is — so userId is null there and the credential response itself
// (its credentialId) is what resolves to an account. `id` doubles as the
// opaque handle the client hands back at the second step (a challengeId),
// same "random single-use value, no separate secret needed" reasoning as
// LoginRequest.token.
model WebauthnChallenge {
  id        String   @id @default(uuid())
  challenge String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      WebauthnChallengeType
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum WebauthnChallengeType {
  REGISTRATION
  AUTHENTICATION
}

// CSRF/replay protection for the Google/Apple redirect dance: /oauth/:provider/start
// mints one of these before sending the browser off to the provider, the
// provider echoes `id` back as `state`, and the callback checks it matches
// (and hasn't been used or expired) before trusting anything else in the
// request. `nonce` is separately embedded in the authorize request and
// re-checked against the *id_token's* own nonce claim — state proves the
// callback correlates to a request this server made; nonce proves the
// id_token wasn't lifted from a different, earlier authentication.
// Usually fully anonymous — there's no account to attach this to until the
// provider's response resolves one, same reasoning as WebauthnChallenge's
// login branch. The one exception is linkUserId: Settings' "Connect
// Google/Apple" starts this same flow already signed in, and needs the
// callback to attach the resulting identity to *that* account rather than
// running the normal login-or-create resolution — which matters
// specifically when the provider account's email doesn't match the
// signed-in account's, so email-matching alone can't be trusted to do it.
model ExternalAuthState {
  id         String       @id @default(uuid())
  provider   AuthProvider
  nonce      String
  linkUserId String?
  linkUser   User?        @relation(fields: [linkUserId], references: [id], onDelete: Cascade)
  // Where to send the browser after a successful login — validated the
  // same way LoginPage's own `next` query param is (must be an in-app
  // relative path), stored here rather than round-tripped through the
  // provider since not every provider guarantees passing arbitrary extra
  // query params back untouched.
  redirectPath String
  expiresAt DateTime
  createdAt DateTime     @default(now())
}

// The callback endpoints (hit by a real browser redirect from Google/Apple,
// not a fetch call this app's frontend controls) can't hand back tokens as
// a JSON response — there's nothing to receive one. So the callback
// resolves the user, then redirects the browser to the frontend with one
// of these as a one-time opaque code; the frontend immediately exchanges
// it for a real session via a normal POST. Keeps the actual bearer
// credentials out of the URL/browser history/Referer header — only this
// single-use, 60-second-lived code goes there instead.
model OAuthLoginExchange {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// The QR / deep-link login handshake described in the proposal: short-lived, single-use.
model LoginRequest {
  id            String              @id @default(uuid())
  token         String              @unique
  method        LoginRequestMethod
  status        LoginRequestStatus  @default(PENDING)

  requestingIp       String?
  requestingDevice   String?
  requestingBrowser  String?
  requestingLocation String?

  userId        String?             // set once approved
  user          User?               @relation(fields: [userId], references: [id])

  expiresAt     DateTime
  approvedAt    DateTime?
  deniedAt      DateTime?
  // Set the moment the desktop side redeems an APPROVED request for a real
  // session, via /exchange. Guards against exchanging the same approval twice.
  sessionIssuedAt DateTime?
  createdAt     DateTime            @default(now())

  @@index([token])
  @@index([status])
}

// Milestone 5 (CRYNDY + NDYBITS): a purchase moving through the presale
// pipeline, from payment intake through compliance review to on-chain
// distribution. The status itself is the source of truth for what a user is
// allowed to see as "available" — ALLOCATED/LOCKED CRYNDY is owned but not
// yet spendable, and only AVAILABLE/DISTRIBUTED_ON_CHAIN should ever be
// summed into a balance a user can act on.
enum CryndyPurchaseStatus {
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  UNDER_REVIEW
  VERIFIED
  ALLOCATED
  LOCKED
  AVAILABLE
  DISTRIBUTED_ON_CHAIN
  CANCELLED
  REFUNDED
}

model CryndyPurchase {
  id        String @id @default(uuid())
  // Human-facing receipt number, e.g. CRY-2026-07-000184. Distinct from `id`
  // (uuid) so support/finance can reference something readable; not relied
  // on for uniqueness enforcement anywhere else in the system.
  reference String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amountPaid Decimal @db.Decimal(18, 2)
  currency   String // ISO 4217, e.g. "USD"

  cryndyAmount Decimal @db.Decimal(28, 8)
  bonusAmount  Decimal @default(0) @db.Decimal(28, 8)
  packageName  String?

  paymentMethod String // e.g. "card", "bank_transfer", "crypto"
  status        CryndyPurchaseStatus @default(PAYMENT_PENDING)

  // The presale site's own transaction id. Unique so the same webhook
  // delivery, replayed any number of times, only ever produces one row.
  providerTransactionId String @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  verifiedAt  DateTime?
  allocatedAt DateTime?

  @@index([userId])
  @@index([status])
}

enum NdybitsRiskFlag {
  NONE
  FLAGGED_VELOCITY
  FLAGGED_DUPLICATE
  FLAGGED_MANUAL_REVIEW
}

// Append-only NDYBITS movement log. Balance is derived by summing this
// table rather than kept as a cached counter on User — see NdybitsService
// for why (correctness over micro-optimizing a read that isn't hot yet).
model NdybitsLedgerEntry {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount Int // positive = credit, negative = debit
  reason String // e.g. "daily_login", "referral_bonus", "purchase_reward"

  // Nullable — a manual/admin credit has no external event to key off of.
  // When set (e.g. "cryndy_purchase:<purchaseId>"), it's what makes
  // creditNdybits() idempotent: the same triggering event can never post
  // two ledger entries, even if whatever calls it retries.
  sourceEventId String? @unique

  // Groups entries from the same reward campaign, e.g. "launch_referral_2026"
  // — nullable since not every credit originates from a campaign (a manual
  // admin adjustment, for instance).
  campaignId String?
  // Fraud/anti-abuse status per the client's explicit requirement that this
  // exist "before the bridge becomes economically valuable" — set by
  // RewardEngineService's velocity checks, never by the crediting call
  // site directly. NONE for the overwhelming majority of entries.
  riskFlag   NdybitsRiskFlag @default(NONE)
  // Set once this specific entry's NDYBITS have been consumed by a
  // NDYBITS -> CRYNDY bridge conversion (BridgeRequest below). Per the
  // client's explicit requirement: converted NDYBITS are never deleted or
  // left spendable — they stay visible in history, permanently marked
  // "redeemed," and never counted again. NdybitsService's balance query
  // must exclude redeemed entries once real bridge execution exists (not
  // yet — see BridgeRequest's own "no execution path built" note).
  redeemedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([campaignId])
}

// Milestone 4: tier names and real pricing are a business decision the
// client still needs to confirm (see NDYAPPS-INTEGRATION.md-style open
// items) — these six match the brief's placeholder names exactly so
// renaming later is a find/replace, not a data-model change.
enum MembershipTier {
  RISE
  FLOW
  PULSE
  VAULT
  MODE
  LEGACY
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

// One row per subscription period, not one row per user — cancelling and
// resubscribing (or changing tiers) creates a new row rather than mutating
// history, so "View membership history" has something real to show.
model Membership {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier          MembershipTier
  billingCycle  BillingCycle
  status        MembershipStatus @default(ACTIVE)

  startedAt        DateTime  @default(now())
  currentPeriodEnd DateTime
  cancelledAt      DateTime?

  // Null in local/dev environments without a Stripe key — see
  // MembershipService.subscribe for the dev-mode direct-activation path
  // that fills these in only once real Stripe is configured.
  stripeSubscriptionId String? @unique
  stripeCustomerId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// One row per successfully-processed Stripe event id. Stripe retries
// webhook deliveries until it gets a 2xx, so the same event can legitimately
// arrive more than once — this table is what makes handleCheckoutCompleted
// et al. safe to run twice on the same event instead of double-cancelling/
// double-creating a membership. Checked by StripeWebhookController before
// dispatching, same idempotency shape as CryndyPurchase.providerTransactionId.
model ProcessedStripeEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
}

// Deliberately not a foreign-key relation to User — an audit trail needs to
// survive the record it describes (e.g. an admin account that's later
// demoted, or eventually a deleted user), so both sides are denormalized
// snapshots of who/what at the time the action happened, not live links.
model AuditLogEntry {
  id            String   @id @default(uuid())
  adminUserId   String
  adminNdyId    String
  action        String   // e.g. "user.suspend", "user.role.update"
  targetUserId  String?
  targetNdyId   String?
  previousValue Json?
  newValue      Json?
  reason        String?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
}

enum RoleChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Dual-approval for role changes — the client's explicit requirement for
// "critical actions." A role change no longer applies the moment one admin
// clicks a button: it creates a PENDING row here, and a *different* admin
// (see RoleChangeRequestService.approve — same person can't approve their
// own request) has to approve it before the role actually changes. Same
// denormalized-snapshot reasoning as AuditLogEntry for who's who.
model RoleChangeRequest {
  id             String @id @default(uuid())
  targetUserId   String
  targetNdyId    String
  requestedRole  Role
  previousRole   Role

  requestedByUserId String
  requestedByNdyId  String
  requestReason     String?

  status RoleChangeRequestStatus @default(PENDING)

  reviewedByUserId String?
  reviewedByNdyId  String?
  reviewReason     String?
  resolvedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([targetUserId])
}

// --- SSO / OAuth2 + OpenID Connect provider ---
// NDY HUB is the identity provider; every connected NDJOYIT site is a
// registered "client" (relying party) that redirects here to authenticate
// instead of keeping its own password table. This is the missing piece
// that makes "one login for the ecosystem" true past NDY HUB's own
// dashboard — see NDYAPPS-INTEGRATION.md for the mobile-app equivalent.

// CONFIDENTIAL: a real backend (NDJOYIT, a server-side integration) that
// can keep clientSecretHash's plaintext counterpart genuinely secret.
// PUBLIC: a native/mobile app (Flutter, Android, iOS) or any client whose
// binary end users can decompile — a "secret" baked into an APK isn't one.
// Per RFC 8252 (OAuth 2.0 for Native Apps) and OAuth 2.1, PUBLIC clients
// never receive a client_secret at all and MUST use PKCE instead — see
// TokenController's grant handling and AuthorizeController's PKCE
// enforcement for where this distinction is actually applied.
enum OAuthClientType {
  CONFIDENTIAL
  PUBLIC
}

// Admin-managed (see AdminOAuthClientsController) — one row per connected
// website or app. clientSecretHash follows the same pattern as refresh
// tokens throughout this schema: only a hash is ever stored, the plaintext
// secret is shown to the admin exactly once, at creation. Null for PUBLIC
// clients — they never get a secret to begin with, not just one that's
// hidden after creation.
model OAuthClient {
  id               String          @id @default(uuid())
  clientId         String          @unique
  clientSecretHash String?
  clientType       OAuthClientType @default(CONFIDENTIAL)
  name             String   // shown on the consent screen, e.g. "NDJOYIT Services"
  redirectUris     String[] // exact-match whitelist — no partial/prefix matching
  allowedScopes    String[] // subset of the supported scope list this client may ever request
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  authorizationCodes OAuthAuthorizationCode[]
  grants             OAuthGrant[]
  refreshTokens      OAuthRefreshToken[]

  @@index([clientId])
}

// Short-lived, single-use — same shape and same reasoning as LoginRequest:
// a code is only ever good for one exchange at the token endpoint.
model OAuthAuthorizationCode {
  id          String      @id @default(uuid())
  code        String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  redirectUri String
  scope       String      // space-separated, the actual scopes approved for this grant
  // PKCE (RFC 7636) — optional per-request, verified at /oauth/token if
  // present. Only S256 is accepted; "plain" is deliberately unsupported
  // (OAuth 2.1 drops it too — a challenge that doesn't need hashing to
  // verify isn't proof of anything). Every OAuthClient here is confidential
  // (has a client_secret), so PKCE isn't covering for a missing client
  // secret the way it does for a public/mobile client — it's an extra
  // layer against authorization-code interception regardless of client type.
  codeChallenge       String?
  codeChallengeMethod String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([code])
  @@index([userId])
}

// What a user has approved a given client to see — checked before showing
// the consent screen again (a returning user with an unchanged scope skips
// straight back to their app), and what "Revoke a website connection" on
// the Security page deletes.
model OAuthGrant {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scope     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  revokedAt DateTime?

  @@unique([userId, clientId])
  @@index([userId])
}

// A refresh token issued to a *third-party client*, not NDY HUB's own
// dashboard — deliberately a separate table from Session so revoking one
// connected website never touches the user's own NDY HUB login, and vice
// versa.
model OAuthRefreshToken {
  id        String      @id @default(uuid())
  tokenHash String      @unique
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scope     String
  // Shared by every token descended from one original grant — set once at
  // issue time, carried forward unchanged across every rotation. This is
  // what makes reuse detection possible: presenting an already-revoked
  // token is the standard signal a refresh token was stolen, and the
  // correct response is killing the whole family (every token sharing
  // this id), not just the one presented. See
  // OAuthTokenService.rotateRefreshToken.
  familyId  String
  createdAt DateTime    @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([clientId])
  @@index([familyId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the refresh token, never the raw value — a leaked database
  // row shouldn't be a usable credential.
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

enum SecurityEventType {
  LOGIN_SUCCESS
  NEW_DEVICE
  PASSWORD_CHANGED
  PASSKEY_ADDED
  PASSKEY_REMOVED
  TOTP_ENABLED
  TOTP_DISABLED
  SMS_2FA_ENABLED
  SMS_2FA_DISABLED
  RECOVERY_CODE_USED
  EMAIL_CHANGED
  OAUTH_APP_CONNECTED
  OAUTH_APP_REVOKED
  // An already-rotated (revoked) OAuth refresh token was presented again —
  // the standard signal a refresh token was stolen and an attacker is
  // racing the legitimate client. See OAuthTokenService.rotateRefreshToken.
  OAUTH_TOKEN_REUSE_DETECTED
}

// A user-facing "what happened on my account" timeline — distinct from
// AuditLogEntry, which only records admin actions taken *on* a user
// (suspend, role change) and requires an adminUserId. This is self-service:
// every row is an event the account owner should be able to see about
// their own account, per the client's explicit "security history" spec.
model SecurityEvent {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SecurityEventType
  ip        String?
  userAgent String?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
}

// A user's own request; a single admin reply resolves it. Deliberately not
// a full threaded-conversation ticketing system — one message in, one
// message back, marked resolved. Real back-and-forth can graduate this
// into something richer once there's actual support volume to justify it.
model SupportTicket {
  id         String              @id @default(uuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  message    String
  status     SupportTicketStatus @default(OPEN)
  adminReply String?
  repliedAt  DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId])
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
}

// --- NDYSPACE ("Your Digital Space") ---
// A unified productivity workspace (mail, calendar, drive, contacts, tasks,
// notes, bookmarks, notifications) layered on top of the existing NDY HUB
// identity — every model below FKs to the same User above, guarded by the
// same JwtAuthGuard, exactly like every other per-user module in this file.
// No new auth/session/identity concept is introduced anywhere in this block.

// --- NDYMAIL ---
// Internal-only mail: NDYSPACE users emailing other NDYSPACE users. There is
// deliberately no SMTP/IMAP integration here — see NdyspaceMailService for
// what "send" actually does (creates a delivered EmailRecipient row for
// each recipient in the same request, no outbound transport involved).
// Real external email federation is a later-phase concern.
enum EmailFolder {
  INBOX
  SENT
  DRAFTS
  TRASH
}

// Dashboard widget tabs (§2.4 of the spec) group by this — every message
// defaults to PRIMARY since there's no real classification model yet; this
// is a static field, not inferred, and that's an explicit, documented
// scope cut for this pass.
enum EmailCategory {
  PRIMARY
  SOCIAL
  UPDATES
  PROMOTIONS
}

// One row per sent message; delivery to each recipient is a separate
// EmailRecipient row below (its own read/starred/folder state) rather than
// duplicating the message body per recipient — the same "one fact, one
// place" reasoning as every append-only/normalized table elsewhere in this
// schema. Attachments are handled by EmailAttachment below (server-resolved
// against the sender's Drive, since DriveFile is otherwise owner-only).
model Email {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("EmailSender", fields: [senderId], references: [id], onDelete: Cascade)
  subject     String
  body        String
  category    EmailCategory @default(PRIMARY)
  createdAt   DateTime @default(now())

  recipients  EmailRecipient[]
  attachments EmailAttachment[]

  @@index([senderId, createdAt])
}

// The recipient-side mailbox row — read/starred/folder state is per
// recipient (deleting from your own Trash must never affect the sender's
// Sent view or another recipient's Inbox), same reasoning as why this isn't
// just a boolean column on Email itself. isCc distinguishes To vs Cc for
// display only — both get a normal INBOX copy, delivery is identical.
// draftToNdyIds/draftCcNdyIds hold the not-yet-resolved recipient list while
// a message sits in DRAFTS (folder = DRAFTS, no other EmailRecipient rows
// exist yet for this Email) — sending converts the draft into the real
// SENT/INBOX rows and clears these back to empty.
model EmailRecipient {
  id            String      @id @default(uuid())
  emailId       String
  email         Email       @relation(fields: [emailId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        EmailFolder @default(INBOX)
  isRead        Boolean     @default(false)
  isStarred     Boolean     @default(false)
  isCc          Boolean     @default(false)
  draftToNdyIds String[]    @default([])
  draftCcNdyIds String[]    @default([])
  createdAt     DateTime    @default(now())

  @@unique([emailId, userId])
  @@index([userId, folder, createdAt])
}

// Links a sent Email to one of the sender's DriveFile rows. Deliberately not
// routed through the normal owner-scoped Drive endpoints — a recipient has
// no Drive ACL on the sender's files, so the mail read path resolves
// DriveFile rows itself (server-side, using the Email's senderId) and hands
// back a plain {name, mimeType, sizeBytes, url} in the message payload.
model EmailAttachment {
  id          String    @id @default(uuid())
  emailId     String
  email       Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  driveFileId String
  driveFile   DriveFile @relation(fields: [driveFileId], references: [id], onDelete: Cascade)
  addedAt     DateTime  @default(now())

  @@index([emailId])
  @@index([driveFileId])
}

// --- Calendar ---
// Simple non-recurring events for v1 — see spec §3: "Attendee/Recurrence
// can be a follow-up." attendeeEmails is a plain string array rather than a
// join table for the same reason: an attendee here doesn't need to be an
// NDYSPACE user, just an email address shown on the event.
model CalendarEvent {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  startAt        DateTime
  endAt          DateTime
  // Hex color for the widget's accent bar (§2.5) — free-form rather than an
  // enum so the palette can grow without a migration.
  color          String   @default("#4f7cff")
  attendeeEmails String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, startAt])
}

// --- Drive ---
// Folders are a flat, single-level owner-scoped list for this pass — a
// folder can hold files but not other folders (nested folders are a
// reasonable follow-up, not required by the spec's UI inventory, which only
// ever shows a flat "Folder rows" list in the Drive widget, §2.7).
model DriveFolder {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime   @default(now())

  files     DriveFile[]

  @@index([userId])
}

// storageKey is what PhotoStorageService-style storage (Vercel Blob in
// prod, local disk in dev — see DriveStorageService) hands back; url is the
// actual fetchable location, kept alongside storageKey the same way
// PhotoStorageService's callers keep just a URL, but this also needs the
// key/local-path shape preserved for deletion. folderId is nullable — a
// file can live directly at Drive's root, same "optional parent" shape as
// nothing-required elsewhere in this schema.
model DriveFile {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      DriveFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  name        String
  mimeType    String
  sizeBytes   Int
  url         String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  emailAttachments EmailAttachment[]

  @@index([userId, folderId])
  @@index([userId, createdAt])
}

// --- Contacts ---
// ndyId is optional: Contacts are the user's personal address book (not
// NDY HUB accounts) and normally have no NDY ID at all. When a contact is
// linked to a real NDYSPACE user, NDYMAIL's compose recipient picker can
// suggest it by NDY ID; unlinked contacts just don't show up there.
model Contact {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  email     String?
  phone     String?
  company   String?
  notes     String?
  ndyId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// --- Tasks ---
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  OPEN
  COMPLETED
}

model Task {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status])
}

// --- Notes ---
model Note {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

// --- Bookmarks ---
model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  url       String
  createdAt DateTime @default(now())

  @@index([userId])
}

// --- Notifications ---
// Deliberately its own model rather than reusing SecurityEvent: SecurityEvent
// is specifically an account-security audit trail with a fixed, security-only
// type enum (see its own doc comment) and no read/unread state — bolting a
// generic "mark as read" notification concept onto it would blur that
// boundary for every existing security-page consumer. NdyspaceNotification
// instead follows the same per-user, typed, timestamped shape but adds the
// read state and free-form message a general notification feed needs.
// Generated by NDYSPACE modules themselves for now (e.g. NDYMAIL send —
// see NdyspaceMailService) rather than any cross-cutting event bus.
enum NdyspaceNotificationType {
  MAIL
  CALENDAR
  TASK
  SYSTEM
}

model NdyspaceNotification {
  id        String                   @id @default(uuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NdyspaceNotificationType
  message   String
  isRead    Boolean                  @default(false)
  createdAt DateTime                 @default(now())

  @@index([userId, isRead, createdAt])
}

// --- Workspace / tenancy foundation ---
// The precondition almost everything else silently assumes: NDY Business
// Center (team membership + roles), the Action Engine (its own
// ActionRequest contract already carries a workspaceId), and any future
// Circle/shared-content linkage all need a real notion of "which tenant
// is this happening inside." Introduced now, invisibly — every existing
// user gets exactly one PERSONAL workspace of size 1 in the backfill
// migration, so nothing about today's product changes. See
// WorkspaceService.getOrCreatePersonalWorkspace for the runtime
// equivalent used by any newly-created user going forward.
enum WorkspaceType {
  PERSONAL
  BUSINESS
}

// Deliberately a separate axis from the global Role enum on User — a
// platform SUPER_ADMIN is not automatically a workspace OWNER, and vice
// versa. WorkspaceGuard checks this; PermissionGuard checks Role. Kept to
// three values for v1 (see docs/action-engine-design.md's sibling plan
// doc) — a fuller "multiple roles worn simultaneously" matrix is a later,
// separately-scoped decision, not assumed here.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id          String                @id @default(uuid())
  type        WorkspaceType
  // For PERSONAL workspaces: denormalized from the owner's fullName/ndyId
  // at creation time, purely for display — never used as a lookup key.
  name        String
  ownerUserId String
  // Set only for type: BUSINESS, once a BusinessWorkspaceRequest is
  // approved — same "public-facing, permanent, six-char" shape as
  // User.ndyId's core segment, formatted as "NDY-BIZ-XXXXXX" via the same
  // ndy-id.util.ts helpers (extended for a Workspace-level id rather than
  // a User-level one — a business is a tenant, not a personal identity).
  // Null for PERSONAL workspaces, which never had a business id concept.
  ndyBusinessId String?             @unique
  createdAt   DateTime              @default(now())
  memberships WorkspaceMembership[]
  invites     WorkspaceInvite[]

  @@index([ownerUserId])
}

model WorkspaceMembership {
  id          String        @id @default(uuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  // Free-text department label, per the client's explicit "include a
  // simple department field now" answer (reversing this doc's own earlier
  // "recommend deferring" note) — plain optional string, not its own
  // model/enum, since there's no department-scoped permission or
  // reporting feature yet for a richer model to serve.
  department  String?
  createdAt   DateTime      @default(now())

  // A user can't join the same workspace twice — this is what makes
  // WorkspaceService.getOrCreatePersonalWorkspace's upsert-style create
  // safe to call more than once for the same user without duplicating rows.
  @@unique([workspaceId, userId])
  @@index([userId])
}

enum BusinessWorkspaceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Per the client's explicit "admin-approved — creation request goes
// through the same propose/approve pattern as role changes" answer.
// Structurally identical to RoleChangeRequest: propose (PENDING row),
// separate resolution step, apply. Explicitly designed so approval can
// later become automated/risk-based (via NDY Trust/business verification)
// without a schema change — that's just a different `resolve()` caller,
// not a different table shape.
model BusinessWorkspaceRequest {
  id                String                         @id @default(uuid())
  requestedByUserId String
  requestedByNdyId  String
  businessName      String
  requestReason     String?
  status            BusinessWorkspaceRequestStatus @default(PENDING)

  reviewedByUserId  String?
  reviewedByNdyId   String?
  reviewReason      String?
  resolvedAt        DateTime?

  // Set once APPROVED — the resulting Workspace's id, so the requester
  // (and any UI polling this request) can find the workspace it created.
  createdWorkspaceId String?

  createdAt         DateTime                       @default(now())

  @@index([status])
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

// Same single-use/TTL token shape as every other invite/reset token on
// User (see User.emailVerificationTokenHash) — token-based accept, no
// dual-actor approval needed (inviting yourself makes no sense, so this
// is simpler than BusinessWorkspaceRequest/RoleChangeRequest above).
model WorkspaceInvite {
  id              String                 @id @default(uuid())
  workspaceId     String
  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedEmail    String
  invitedRole     WorkspaceRole
  invitedDepartment String?
  invitedByUserId String
  invitedByNdyId  String
  status          WorkspaceInviteStatus  @default(PENDING)
  tokenHash       String                 @unique
  expiresAt       DateTime
  resolvedAt      DateTime?
  createdAt       DateTime               @default(now())

  @@index([workspaceId, status])
}

// --- Central notification backbone (Phase 2) ---
// NdyspaceNotification (above) is explicitly scoped to NDYSPACE only, per
// its own schema comment — reusing it for security/economy/action-approval
// events would be scope creep on a model deliberately kept narrow. This is
// its sibling for everything else: a general, typed, cross-cutting
// notification with a real delivery channel, so future features (the
// Action Engine's approval alerts, NDYBITS reward credits, security
// alerts) all write through one mechanism instead of each inventing an
// ad hoc notification path. NdyspaceNotification stays exactly as-is —
// not migrated or merged here, that's a separate future cleanup if ever
// warranted, not a Phase 2 requirement.
enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum NotificationCategory {
  SECURITY
  ECONOMY
  ACTION_APPROVAL
  NDYSPACE
  SYSTEM
}

model Notification {
  id          String               @id @default(uuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Null for personal/global notifications; set once workspace-scoped
  // events exist (Phase 4+) so a notification can be attributed to the
  // business workspace it happened in, not just the user.
  workspaceId String?
  category    NotificationCategory
  channel     NotificationChannel
  title       String
  body        String
  linkUrl     String?
  isRead      Boolean              @default(false)
  // Same idempotency pattern as NdybitsLedgerEntry.sourceEventId — set by
  // callers that key off a real external/internal event (a reward credit,
  // an approval request) so the same event can never post two
  // notifications even if the caller retries.
  sourceEventId String?            @unique
  createdAt   DateTime             @default(now())

  @@index([userId, isRead, createdAt])
}

// --- Action Engine (Phase 3) ---
// Built exactly per docs/action-engine-design.md, already reviewed with
// the client. The trust-zone split: the Fabric/AI layer (not built yet)
// is allowed to be wrong; this is the only component that actually
// mutates data, and it reaches its own conclusion about validity rather
// than trusting whatever proposed the action. v1 registers a handful of
// real, already-built actions as proof of the pattern — see
// ActionEngineService for the registry and execution flow.
enum ActionRiskTier {
  LOW      // reversible, no external visibility
  MEDIUM   // visible to others or moderately hard to reverse
  HIGH     // hard to reverse or touches sensitive data
  CRITICAL // financial or identity-security actions
}

// A real table, not just a code convention — lets the Approval Center and
// audit UI enumerate "every action that exists" without hardcoding a list
// in five places. Registering an action here is a deliberate, reviewed
// step, same discipline as oauth/scopes.ts's "add scopes as real clients
// need them, not speculatively."
model ActionDefinition {
  id               String         @id @default(uuid())
  actionKey        String         @unique // e.g. "calendar.event.create"
  label            String
  domain           String         // "calendar" | "contacts" | "tasks" | "ndyspace" | ...
  riskTier         ActionRiskTier
  requiredScopes   String[]       // reuses oauth/scopes.ts's vocabulary
  reversible       Boolean        @default(false)
  reverseActionKey String?
  // Kill switch — disable an action ecosystem-wide without a deploy.
  enabled          Boolean        @default(true)
  createdAt        DateTime       @default(now())

  @@index([domain])
}

enum ActionApprovalStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

// The same shape as RoleChangeRequest, generalized: propose (Action
// Engine creates a PENDING row here) -> separate resolution step ->
// apply. LOW-risk actions never get a row here at all — they execute
// immediately once authorized+validated.
model ActionApproval {
  id                 String               @id @default(uuid())
  actionLogId        String               @unique
  actionLog          ActionLogEntry       @relation(fields: [actionLogId], references: [id], onDelete: Cascade)
  riskTier           ActionRiskTier
  status             ActionApprovalStatus @default(PENDING)
  // true for CRITICAL — approval must include a fresh passkey/2FA check,
  // not just an active session. Not enforced by this table itself; the
  // approval-resolution endpoint is what actually requires it (v1 has no
  // CRITICAL actions registered yet, so nothing exercises this path today
  // — the field exists so v2+ needs no schema change to use it).
  requiresStrongAuth Boolean              @default(false)
  // PENDING approvals expire — an unconfirmed request shouldn't sit
  // executable forever.
  expiresAt          DateTime
  resolvedByUserId   String?
  resolvedAt         DateTime?
  createdAt          DateTime             @default(now())

  @@index([status])
}

enum ActionExecutionStatus {
  REJECTED
  PENDING_APPROVAL
  EXECUTED
  DENIED
}

// ActionLogEntry is AuditLogEntry's sibling for this pipeline, not a
// replacement — same denormalized-actor-snapshot shape (survives account
// changes), logs every request at every stage including rejections, since
// a denied action is itself a security signal worth keeping.
model ActionLogEntry {
  id                String                 @id @default(uuid())
  actionKey         String
  workspaceId       String
  requestedByUserId String
  requestedByNdyId  String
  // Who/what originated this request — never omitted. The Action Engine
  // treats every origin identically once past Authorize; the AI gets no
  // special trust. Stored as Json rather than a typed column since the
  // "detail" sub-field is free text that varies by origin type.
  origin            Json
  params             Json
  status            ActionExecutionStatus
  riskTier          ActionRiskTier
  reason            String?                // populated on REJECTED/DENIED
  resultSummary     Json?                  // populated on EXECUTED — a small summary, not the full domain object
  idempotencyKey    String                 @unique
  createdAt         DateTime               @default(now())

  approval          ActionApproval?

  @@index([workspaceId, createdAt])
  @@index([requestedByUserId])
}

// --- NDY Economy (Phase 5/6) ---
// Everything below is the client's full "EARN -> CONVERT -> USE -> BUILD
// -> UPGRADE" architecture, built as real, working, but genuinely
// unactivated infrastructure — matching the client's own explicit
// instruction: "let's build the infrastructure first and activate the
// financial functions only after tokenomics, security, treasury rules and
// legal/compliance have been professionally reviewed." No real money
// moves anywhere in this section. No blockchain, no smart contracts, no
// NDYX data model (NDYX is gated behind a blockchain choice and legal
// audit that hasn't happened — a placeholder ledger table for it would
// misrepresent how far along it is).

// The Reward Engine's authoritative catalog — the client's explicit
// requirement that "apps send verified events, NDYHUB's Reward Engine
// decides the reward amount, apps must never independently create
// balances" made real. amount is never accepted from a caller; it's
// always looked up here.
model RewardRule {
  id               String   @id @default(uuid())
  eventKey         String   @unique // e.g. "QUIZ_COMPLETED", "DAILY_LOGIN", "REFERRAL_SIGNUP"
  label            String
  amount           Int      // server-side authoritative NDYBITS amount
  maxPerUserPerDay Int?
  // Off by default — real amounts are a business/economics decision the
  // client still needs to confirm (flagged in the architecture audit),
  // same "ship the mechanism, not the numbers" discipline as everywhere
  // else in this section.
  enabled          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// One row per verified event report from an ecosystem app (NDYQUIZ,
// NDJOYITSTEPS, etc.) — the audit trail behind RewardRule's decision,
// per the client's explicit "NDYHUB records: user, application, event,
// reward, timestamp" requirement. Distinct from NdybitsLedgerEntry: this
// is "what event happened and what NDYHUB decided," the ledger entry (if
// any) is "the resulting balance movement." A rejected/rate-limited event
// still gets a row here (denied=true, no ledger entry), same "log
// everything including rejections" discipline as ActionLogEntry.
model NdyEconomyEventLog {
  id            String   @id @default(uuid())
  eventKey      String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which registered OAuthClient reported this event — apps report
  // events, they never credit balances directly. Nullable only for
  // internally-originated events (e.g. an admin manually triggering a
  // reward rule for testing).
  reportedByClientId String?
  sourceEventId String   @unique // idempotency key, same contract as NdybitsLedgerEntry.sourceEventId
  denied        Boolean  @default(false)
  denyReason    String?
  ledgerEntryId String?  @unique
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventKey])
}

// The Bridge Engine's request lifecycle — covers both NDYBITS->CRYNDY
// (Bridge 1) and CRYNDY->NDYX (Bridge 2) with one shared shape, since the
// client's own spec describes them as structurally identical pipelines at
// different risk tiers. direction is a string, not an enum, deliberately
// — a future third bridge or a renamed direction doesn't need a schema
// migration.
enum BridgeRequestStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
  COOLING_OFF
  APPROVED
  EXECUTED
  REJECTED
}

model BridgeRequest {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction       String              // "NDYBITS_TO_CRYNDY" | "CRYNDY_TO_NDYX"
  sourceAmount    Decimal             @db.Decimal(28, 8)
  // Snapshot of ConversionPolicy.rate at request time — never recomputed
  // retroactively, per the client's explicit "no permanent guaranteed
  // rate" requirement (the policy can change; a quoted request shouldn't
  // silently reprice underneath the user).
  quotedRate      Decimal             @db.Decimal(18, 8)
  status          BridgeRequestStatus @default(PENDING)
  // Why ineligible, if applicable — surfaced back to the user rather than
  // a bare rejection.
  eligibilityNote String?
  coolingOffUntil DateTime?
  // Unique human-facing reference, e.g. "NBR-2026-8F72KD", per the
  // client's explicit "every conversion gets a unique Bridge Transaction
  // ID" requirement. Distinct from id (uuid) the same way
  // CryndyPurchase.reference is distinct from its own id.
  bridgeTransactionRef String            @unique
  createdAt       DateTime            @default(now())
  resolvedAt      DateTime?

  @@index([userId, status])
  @@index([direction])
}

// A live-editable policy row, not a hardcoded constant — the client's
// explicit "NDY Conversion Policy Engine" requirement: reference rates
// (10 NDYBITS:1 CRYNDY, 100 CRYNDY:1 NDYX) exist here as real, changeable
// data, never baked into application code. One row per direction.
model ConversionPolicy {
  id              String   @id @default(uuid())
  direction       String   @unique // "NDYBITS_TO_CRYNDY" | "CRYNDY_TO_NDYX"
  rate            Decimal  @db.Decimal(18, 8) // units of source per 1 unit of target
  minBridgeAmount Decimal? @db.Decimal(28, 8) // e.g. minimum 10 CRYNDY per Bridge 2 request, prevents micro-transaction spam
  dailyCapPerUser Decimal? @db.Decimal(28, 8)
  // The treasury/reserve balance this policy is allowed to draw against —
  // the client's explicit "check available conversion pool before any
  // conversion" requirement, made real even though nothing here ever
  // reaches EXECUTED yet.
  reserveBalance  Decimal  @default(0) @db.Decimal(28, 8)
  // Off by default — this is the literal "architecture-ready, not
  // activated" switch. Nothing in this codebase ever sets this true;
  // flipping it is a deliberate, reviewed, post-legal-review operational
  // decision, not a deploy.
  enabled         Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// --- Passport structured claims (Phase 7) ---
// Passport fields (bio, country, website, etc.) are already flat typed
// columns on User, not a JSON blob — the real gap this phase closes is
// provenance: nothing distinguishes "NDY HUB self-asserted" from
// "third-party-verified" per claim, and VerificationLevel is a single
// scalar on User, not per-claim. This table sits alongside the existing
// flat User fields (additive, no migration of existing Passport data) —
// new claims opt into it, starting with formalizing identityVerifiedAt
// into a real LEVEL_3 claim row via IdentityVerificationRequest below.
enum ClaimProvenance {
  SELF_ASSERTED
  NDY_VERIFIED
  THIRD_PARTY_CREDENTIAL
}

model PassportClaim {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  claimKey   String           // e.g. "phone_verified", "identity_document"
  provenance ClaimProvenance
  // Null for SELF_ASSERTED/NDY_VERIFIED; populated for
  // THIRD_PARTY_CREDENTIAL, e.g. "EU-DIW" — no such issuer integration
  // exists yet, this column just avoids a future migration when one does.
  issuer     String?
  verifiedAt DateTime?
  // Credential-specific data, kept opaque here on purpose — this table's
  // job is provenance tracking, not modeling every future credential
  // schema (OpenID4VCI or similar, not built).
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@unique([userId, claimKey])
}

enum IdentityVerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// The LEVEL_3 (identity document) manual review flow — per the client's
// explicit answer: NDY HUB owns the request/status/approval/audit trail,
// but deliberately does NOT store the ID/passport document itself. No
// document-upload field exists here on purpose; evidenceNote is a plain
// text pointer to wherever the real evidence was actually handled
// (a support ticket, an email thread) — never the document bytes. Kept
// architecture-ready per the client's explicit instruction: a future
// dedicated secure KYC/document-handling layer can attach to this same
// request row (e.g. via a new evidenceRef pointing at that system) without
// a schema rewrite here.
model IdentityVerificationRequest {
  id             String                             @id @default(uuid())
  userId         String
  user           User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceNote   String?
  status         IdentityVerificationRequestStatus   @default(PENDING)

  reviewedByUserId String?
  reviewedByNdyId  String?
  reviewReason     String?
  resolvedAt       DateTime?

  createdAt      DateTime                           @default(now())

  @@index([status])
  @@index([userId])
}

// --- Ecosystem Event Contract v1 ---
// Phase B of identity-architecture-hardening-plan.md, per the client's
// explicit request for a reusable event architecture ("identity.updated",
// "booking.created", "quiz.completed", etc.) so future NDY products don't
// each need a bespoke sync mechanism. This is the general log every
// ecosystem-relevant event reports through — NdyEconomyEventLog (above)
// stays exactly as it is, purpose-built for reward-specific fields
// (denied/denyReason/ledgerEntryId/riskFlag) that don't belong here.
// RewardEngineService remains the authority on what triggers a NDYBITS
// credit; this table is the shared front door both it and future
// non-reward consumers write through.
//
// Deliberately NOT a data warehouse for every product's internal records
// — per the client's own scoping principle, NDYSTAYS keeps owning
// booking/property data, NDYQUIZ keeps owning game state, etc. This logs
// the *signal* ("a booking was created"), not the product's full record.
model EcosystemEvent {
  id                 String   @id @default(uuid())
  // Namespaced, dot-separated — "quiz.completed", "booking.created",
  // "identity.updated". Validated against a registered catalog at report
  // time (see EcosystemEventService), same "add real ones as clients need
  // them, not speculatively" discipline as oauth/scopes.ts.
  eventType          String
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Which registered OAuthClient reported this — nullable only for
  // internally-originated events (e.g. NDYHUB's own identity.updated).
  reportedByClientId String?
  // Event-specific payload, kept opaque here on purpose — same reasoning
  // as PassportClaim.metadata: this table's job is being a reliable,
  // queryable log, not modeling every future event's exact shape.
  payload            Json?
  // Idempotency — same contract as every other *EventId field in this
  // schema (NdybitsLedgerEntry.sourceEventId, NdyEconomyEventLog.sourceEventId).
  sourceEventId      String   @unique
  createdAt          DateTime @default(now())

  @@index([userId, eventType, createdAt])
  @@index([eventType])
}
