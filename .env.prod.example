# Copy to .env.prod on the server (same directory as docker-compose.prod.yml)
# and fill in real values. Never commit .env.prod — it's gitignored.

# Must exist before the first manual run. The tag matches the GitHub
# Environment this server represents — "staging" for this server today,
# "production" for whatever server takes that role later:
#   ghcr.io/<github-owner>/ndy-hub-api:staging
#   ghcr.io/<github-owner>/ndy-hub-web:staging
IMAGE_API=""
IMAGE_WEB=""

# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=""

# Where the browser reaches each service. IP-only for now (no domain yet);
# swap to https://... once a domain is pointed at this server.
WEB_APP_URL="http://YOUR_DROPLET_IP"
API_URL="http://YOUR_DROPLET_IP:3000"

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
CRYNDY_WEBHOOK_SECRET=""
TOTP_ENCRYPTION_KEY=""

# Gates POST /internal/backup-alert (deploy/backup.sh's failure-notify
# path — see that script's header). Generate with: openssl rand -base64 32.
# Leave blank and the endpoint refuses every request rather than accepting
# unauthenticated ones (fail closed).
INTERNAL_ALERT_SECRET=""

# Off-server backup storage (DigitalOcean Spaces) — see deploy/backup.sh's
# "OFF-SERVER UPLOAD" section and deploy/README.md's Disaster Recovery
# section. Leave SPACES_BUCKET blank and backups stay local-disk-only (a
# documented, visible gap, not a silent one). To enable: DO dashboard ->
# Spaces -> Create a Space, then API -> Spaces Keys -> Generate New Key.
SPACES_BUCKET=""
SPACES_REGION=""
SPACES_ACCESS_KEY=""
SPACES_SECRET_KEY=""

# Error tracking (Sentry) for the API — see apps/api/src/instrument.ts.
# Genuinely inert (Sentry.init() is a documented no-op) until SENTRY_DSN is
# set. Create a free project at sentry.io (Node/NestJS platform) to get one.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"

# Error tracking (Sentry) for the web app — see apps/web/src/instrumentation.ts
# and instrumentation-client.ts. NEXT_PUBLIC_ prefix is required since the
# client-side value ships in the browser bundle; the DSN itself is not a
# secret (it's meant to be public — Sentry's own docs confirm this), so
# that's expected, not a leak. SENTRY_ORG/PROJECT/AUTH_TOKEN are separate
# and only used at *build* time (source map upload) — those three should
# stay real secrets, never shipped to the browser.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Optional — leave blank until real accounts exist. See apps/api/.env.example
# for what each one does.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
OIDC_RSA_PRIVATE_KEY=""
OIDC_RSA_KEY_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
RESEND_API_KEY=""
MAIL_FROM="NDY HUB <onboarding@resend.dev>"
