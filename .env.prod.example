# Copy to .env.prod on the server (same directory as docker-compose.prod.yml)
# and fill in real values. Never commit .env.prod — it's gitignored.

# Must exist before the first manual run. The tag matches the GitHub
# Environment this server represents — "staging" for this server today,
# "production" for whatever server takes that role later:
#   ghcr.io/<github-owner>/ndy-hub-api:staging
#   ghcr.io/<github-owner>/ndy-hub-web:staging
IMAGE_API=""
IMAGE_WEB=""

# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=""

# Where the browser reaches each service. IP-only for now (no domain yet);
# swap to https://... once a domain is pointed at this server.
WEB_APP_URL="http://YOUR_DROPLET_IP"
API_URL="http://YOUR_DROPLET_IP:3000"

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
CRYNDY_WEBHOOK_SECRET=""
TOTP_ENCRYPTION_KEY=""

# Optional — leave blank until real accounts exist. See apps/api/.env.example
# for what each one does.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
OIDC_RSA_PRIVATE_KEY=""
OIDC_RSA_KEY_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
RESEND_API_KEY=""
MAIL_FROM="NDY HUB <onboarding@resend.dev>"
